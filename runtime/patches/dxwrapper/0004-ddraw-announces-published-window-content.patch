 namespace {
+	void PublishWindowPicture(HWND window)
+	{
+		static HANDLE event = []() -> HANDLE
+		{
+			char value[64] = {};
+			const DWORD length = GetEnvironmentVariableA("WINE_NX_WINDOW_PICTURE_EVENT", value, sizeof(value));
+			if (!length || length >= sizeof(value))
+			{
+				return nullptr;
+			}
+			char* next = nullptr;
+			const unsigned long process = std::strtoul(value, &next, 16);
+			if (next == value || *next != ':' || process != GetCurrentProcessId())
+			{
+				return nullptr;
+			}
+			char* first = next + 1;
+			const unsigned long long handle = std::strtoull(first, &next, 16);
+			if (next == first || *next || !handle || handle > UINTPTR_MAX)
+			{
+				return nullptr;
+			}
+			return reinterpret_cast<HANDLE>(static_cast<uintptr_t>(handle));
+		}();
+		static LONG published = 0;
+		if (!event || InterlockedCompareExchange(&published, 0, 0) || !window
+			|| !IsWindowVisible(window) || GetForegroundWindow() != window)
+		{
+			return;
+		}
+		DWORD process = 0;
+		GetWindowThreadProcessId(window, &process);
+		if (process == GetCurrentProcessId() && SetEvent(event))
+		{
+			InterlockedExchange(&published, 1);
+		}
+	}
