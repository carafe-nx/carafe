Carafe: a windowed Direct3D 9 device made on a thread that does not own its window leaves the window's style,
size and order as they are, as DirectDraw does for DDSCL_NORMAL. Changing another thread's window sends that
thread a message and waits for it, so a program whose window thread sleeps while another thread plays a video
through DirectDraw waited forever. Exclusive devices are made on the window's thread and change it as before.
Zlib, as the file it changes.

--- a/d3d9/IDirect3D9Ex.cpp
+++ b/d3d9/IDirect3D9Ex.cpp
@@ -937,6 +937,12 @@
 
 void m_IDirect3D9Ex::AdjustWindowStyle(HWND hWnd, bool IsDirectDrawDevice, bool IsExclusive)
 {
+	if (!IsExclusive && GetWindowThreadProcessId(hWnd, nullptr) != GetCurrentThreadId())
+	{
+		LOG_LIMIT(100, __FUNCTION__ << " Leaving the window of another thread as it is for a windowed device: " << hWnd);
+		return;
+	}
+
 	const LONG lStyle = GetWindowLong(hWnd, GWL_STYLE);
 	const LONG lExStyle = GetWindowLong(hWnd, GWL_EXSTYLE);
 
@@ -1043,6 +1049,12 @@
 		return;
 	}
 
+	if (GetWindowThreadProcessId(hWnd, nullptr) != GetCurrentThreadId())
+	{
+		LOG_LIMIT(100, __FUNCTION__ << " Leaving the size of another thread's window as it is: " << hWnd);
+		return;
+	}
+
 	// Get window style
 	const LONG lOrgStyle = GetWindowLong(hWnd, GWL_STYLE);
 	LONG lStyle = lOrgStyle;
