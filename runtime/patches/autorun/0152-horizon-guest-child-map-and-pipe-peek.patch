+static unsigned int horizon_pipe_peek_fd( int fd, unsigned char *out, unsigned int out_max,
+                                          unsigned int *out_size )
+{
+    struct horizon_pipe_file *file;
+    struct horizon_pipe *pipe;
+    __handle *handle;
+    unsigned int header[4];
+    unsigned int avail, copy_max, to_copy, first;
+
+    *out_size = 0;
+    if (out_max < sizeof(header)) return HORIZON_STATUS_INFO_LENGTH_MISMATCH;
+    if (fd < 0 || horizon_pipe_device == -1 || !(handle = __get_handle( fd )))
+        return HORIZON_STATUS_INVALID_HANDLE;
+    if (handle->device != (unsigned int)horizon_pipe_device || !handle->fileStruct)
+        return HORIZON_STATUS_OBJECT_TYPE_MISMATCH;
+    file = *(struct horizon_pipe_file **)handle->fileStruct;
+    if (!file || file->write_end) return HORIZON_STATUS_ACCESS_DENIED;
+    pipe = file->pipe;
+
+    pthread_mutex_lock( &pipe->mutex );
+    if (!pipe->write_open && !pipe->used)
+    {
+        pthread_mutex_unlock( &pipe->mutex );
+        return HORIZON_STATUS_PIPE_BROKEN;
+    }
+    avail = (unsigned int)pipe->used;
+    copy_max = out_max - (unsigned int)sizeof(header);
+    to_copy = avail < copy_max ? avail : copy_max;
+    header[0] = pipe->write_open ? 3u : 4u;
+    header[1] = avail;
+    header[2] = 0u;
+    header[3] = 0u;
+    memcpy( out, header, sizeof(header) );
+    if (to_copy)
+    {
+        first = HORIZON_PIPE_BUFFER_SIZE - (unsigned int)pipe->head;
+        if (first > to_copy) first = to_copy;
+        memcpy( out + sizeof(header), pipe->buffer + pipe->head, first );
+        if (to_copy > first)
+            memcpy( out + sizeof(header) + first, pipe->buffer, to_copy - first );
+    }
+    pthread_mutex_unlock( &pipe->mutex );
+
+    *out_size = (unsigned int)sizeof(header) + to_copy;
+    return HORIZON_STATUS_SUCCESS;
+}
