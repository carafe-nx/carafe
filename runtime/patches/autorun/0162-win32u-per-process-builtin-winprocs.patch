+
+static struct process_builtin_winprocs *find_child_winprocs_locked( DWORD pid, BOOL create )
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(child_builtin_winprocs); i++)
+        if (child_builtin_winprocs[i].pid == pid) return &child_builtin_winprocs[i];
+    if (!create) return NULL;
+    for (i = 0; i < ARRAY_SIZE(child_builtin_winprocs); i++)
+    {
+        if (!child_builtin_winprocs[i].pid)
+        {
+            memset( &child_builtin_winprocs[i], 0, sizeof(child_builtin_winprocs[i]) );
+            child_builtin_winprocs[i].pid = pid;
+            return &child_builtin_winprocs[i];
+        }
+    }
+    i = child_builtin_winprocs_next++ % ARRAY_SIZE(child_builtin_winprocs);
+    memset( &child_builtin_winprocs[i], 0, sizeof(child_builtin_winprocs[i]) );
+    child_builtin_winprocs[i].pid = pid;
+    return &child_builtin_winprocs[i];
+}
+
+static WINDOWPROC *get_builtin_winprocs_locked( DWORD pid, BOOL create )
+{
+    struct process_builtin_winprocs *slot;
+
+    if (!pid || !root_winproc_pid || pid == root_winproc_pid)
+        return winproc_array;
+    slot = find_child_winprocs_locked( pid, create );
+    return slot ? slot->procs : winproc_array;
+}
+
+static HINSTANCE current_user32_module( void )
+{
+    DWORD pid = current_winproc_pid();
+    HINSTANCE module;
+    struct process_builtin_winprocs *slot;
+
+    pthread_mutex_lock( &winproc_lock );
+    if (!pid || !root_winproc_pid || pid == root_winproc_pid)
+        module = user32_module;
+    else
+    {
+        slot = find_child_winprocs_locked( pid, FALSE );
+        module = (slot && slot->user32_module) ? slot->user32_module : user32_module;
+    }
+    pthread_mutex_unlock( &winproc_lock );
+    return module;
+}
+#else
+static HINSTANCE current_user32_module( void )
+{
+    return user32_module;
+}
+#endif
