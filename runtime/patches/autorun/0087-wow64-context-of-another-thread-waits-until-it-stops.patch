Carafe: with CARAFE_SUSPEND_WAKES=1 reading or writing another thread's x86 context under WoW64 first waits,
through the server, until that thread has stopped. The context was taken from the thread's CPU area at once,
while a thread just suspended could still run its x86 code, so a garbage collector that suspends a thread and
reads its registers (Mono's, in Unity games) could miss live objects and free them.
LGPL-2.1-or-later, as the file it changes.

--- a/dlls/ntdll/unix/signal_arm64.c
+++ b/dlls/ntdll/unix/signal_arm64.c
@@ -154,6 +154,23 @@ static NTSTATUS wow64_context_thread( HANDLE handle, ACCESS_MASK access, struct
     return STATUS_SUCCESS;
 }
 
+static void wow64_wait_stopped( HANDLE handle, struct thread_data *data )
+{
+    static int on = -1;
+    CONTEXT context;
+    BOOL self;
+
+    if (on < 0)
+    {
+        const char *value = getenv( "CARAFE_SUSPEND_WAKES" );
+        on = value && value[0] == '1';
+    }
+    if (!on || data == get_thread_data()) return;
+    memset( &context, 0, sizeof(context) );
+    context.ContextFlags = CONTEXT_ARM64_CONTROL;
+    get_thread_context( handle, &context, &self, IMAGE_FILE_MACHINE_ARM64 );
+}
+
 NTSTATUS set_thread_wow64_context( HANDLE handle, const void *ctx, ULONG size )
 {
     struct thread_data *data;
@@ -162,6 +179,7 @@ NTSTATUS set_thread_wow64_context( HANDLE handle, const void *ctx, ULONG size )
 
     if (size != sizeof(I386_CONTEXT)) return STATUS_INFO_LENGTH_MISMATCH;
     if ((status = wow64_context_thread( handle, THREAD_SET_CONTEXT, &data ))) return status;
+    wow64_wait_stopped( handle, data );
     if (!(cpu = data->teb->TlsSlots[WOW64_TLS_CPURESERVED])) return STATUS_INVALID_PARAMETER;
     return horizon_transfer_i386_context( cpu, get_cpu_area( data, IMAGE_FILE_MACHINE_I386 ),
                                           (I386_CONTEXT *)ctx, TRUE );
@@ -175,6 +193,7 @@ NTSTATUS get_thread_wow64_context( HANDLE handle, void *ctx, ULONG size )
 
     if (size != sizeof(I386_CONTEXT)) return STATUS_INFO_LENGTH_MISMATCH;
     if ((status = wow64_context_thread( handle, THREAD_GET_CONTEXT, &data ))) return status;
+    wow64_wait_stopped( handle, data );
     if (!(cpu = data->teb->TlsSlots[WOW64_TLS_CPURESERVED])) return STATUS_INVALID_PARAMETER;
     return horizon_transfer_i386_context( cpu, get_cpu_area( data, IMAGE_FILE_MACHINE_I386 ), ctx, FALSE );
 }
