+static int log_line_is_final( const char *line )
+{
+    if (!strncmp( line, "[EXIT]", 6 )) return 2;
+    if (!strncmp( line, "[LIFECYCLE] final", 17 )) return 3;
+    if (!strncmp( line, "[LIFECYCLE] verdict", 19 )) return 4;
+    return 0;
+}
+
+static int log_write_budgeted( FILE *file, unsigned long long *used, int *noted,
+                               unsigned int *final_seen, int priority, const char *data, size_t len )
+{
+    unsigned long long limit = CARAFE_LOG_SINK_BYTES;
+    size_t wrote;
+
+    if (!file || !len) return 0;
+    if (priority >= 2)
+    {
+        unsigned int bit = 1u << (priority - 2);
+        if ((*final_seen & bit) || len > 1024 || *used > limit || len > limit - *used) return 0;
+        wrote = fwrite( data, 1, len, file );
+        *used += wrote;
+        if (wrote == len) *final_seen |= bit;
+        return wrote == len;
+    }
+    if (priority < 2) limit = limit > CARAFE_LOG_FINAL_TAIL ? limit - CARAFE_LOG_FINAL_TAIL : 0;
+    if (!priority) limit = limit > CARAFE_LOG_URGENT_TAIL ? limit - CARAFE_LOG_URGENT_TAIL : 0;
+    if (*used > limit || len > limit - *used)
+    {
+        if (!priority && noted && !*noted)
+        {
+            char note[128];
+            int note_len;
+
+            *noted = 1;
+            note_len = snprintf( note, sizeof(note),
+                                 "[LOG] the log reached its %llu MiB budget; only terminal lines follow\n",
+                                 (unsigned long long)(CARAFE_LOG_SINK_BYTES / (1024 * 1024)) );
+            if (note_len > 0 && CARAFE_LOG_SINK_BYTES > CARAFE_LOG_FINAL_TAIL &&
+                *used < CARAFE_LOG_SINK_BYTES - CARAFE_LOG_FINAL_TAIL &&
+                (unsigned long long)note_len <= CARAFE_LOG_SINK_BYTES - CARAFE_LOG_FINAL_TAIL - *used)
+            {
+                wrote = fwrite( note, 1, note_len, file );
+                *used += wrote;
+                fflush( file );
+            }
+        }
+        return 0;
+    }
+    wrote = fwrite( data, 1, len, file );
+    *used += wrote;
+    return wrote == len;
+}
+
 static void runtime_tick_std_streams(void);
 static void runtime_report_interpreter(void);
 
