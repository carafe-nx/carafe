+#endif
+#define CARAFE_LOG_SINK_BYTES (CARAFE_LOG_BUDGET_BYTES / 2)
+#define CARAFE_LOG_URGENT_TAIL (256ull * 1024)
+#define CARAFE_LOG_FINAL_TAIL (64ull * 1024)
+
+static unsigned long long log_file_bytes;
