+static int runtime_image_has_base_relocs( void *module )
+{
+    IMAGE_NT_HEADERS64 *nt = runtime_nt_headers( module );
+    IMAGE_NT_HEADERS32 *nt32 = (IMAGE_NT_HEADERS32 *)nt;
+    const IMAGE_DATA_DIRECTORY *relocs;
+    DWORD dir_count;
+
+    if (!nt || nt->Signature != IMAGE_NT_SIGNATURE) return 0;
+    if (nt->FileHeader.Characteristics & IMAGE_FILE_RELOCS_STRIPPED) return 0;
+    if (nt->OptionalHeader.Magic == IMAGE_NT_OPTIONAL_HDR32_MAGIC)
+    {
+        dir_count = nt32->OptionalHeader.NumberOfRvaAndSizes;
+        relocs = &nt32->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_BASERELOC];
+    }
+    else if (nt->OptionalHeader.Magic == IMAGE_NT_OPTIONAL_HDR64_MAGIC)
+    {
+        dir_count = nt->OptionalHeader.NumberOfRvaAndSizes;
+        relocs = &nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_BASERELOC];
+    }
+    else
+    {
+        return 0;
+    }
+    return dir_count > IMAGE_DIRECTORY_ENTRY_BASERELOC && relocs->VirtualAddress != 0 && relocs->Size != 0;
+}
