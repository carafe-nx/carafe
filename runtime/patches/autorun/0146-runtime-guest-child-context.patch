+    dst->hStdOutput               = HandleToULong( src->hStdOutput );
+    dst->hStdError                = HandleToULong( src->hStdError );
+    dst->CurrentDirectory.Handle  = HandleToULong( src->CurrentDirectory.Handle );
+    dst->dwX                      = src->dwX;
+    dst->dwY                      = src->dwY;
+    dst->dwXSize                  = src->dwXSize;
+    dst->dwYSize                  = src->dwYSize;
+    dst->dwXCountChars            = src->dwXCountChars;
+    dst->dwYCountChars            = src->dwYCountChars;
+    dst->dwFillAttribute          = src->dwFillAttribute;
+    dst->dwFlags                  = src->dwFlags;
+    dst->wShowWindow              = src->wShowWindow;
+    dst->ProcessGroupId           = src->ProcessGroupId;
+
+    cursor = (WCHAR *)(dst + 1);
+    runtime_dup_unicode_string_32( &src->CurrentDirectory.DosPath, &cursor, &dst->CurrentDirectory.DosPath );
+    runtime_dup_unicode_string_32( &src->DllPath, &cursor, &dst->DllPath );
+    runtime_dup_unicode_string_32( &src->ImagePathName, &cursor, &dst->ImagePathName );
+    runtime_dup_unicode_string_32( &src->CommandLine, &cursor, &dst->CommandLine );
+    runtime_dup_unicode_string_32( &src->WindowTitle, &cursor, &dst->WindowTitle );
+    runtime_dup_unicode_string_32( &src->Desktop, &cursor, &dst->Desktop );
+    runtime_dup_unicode_string_32( &src->ShellInfo, &cursor, &dst->ShellInfo );
+    runtime_dup_unicode_string_32( &src->RuntimeInfo, &cursor, &dst->RuntimeInfo );
+    if (src->Environment && src->EnvironmentSize)
+    {
+        dst->Environment = PtrToUlong( cursor );
+        dst->EnvironmentSize = (ULONG)src->EnvironmentSize;
+        memcpy( cursor, src->Environment, src->EnvironmentSize );
+    }
+    return dst;
+}
