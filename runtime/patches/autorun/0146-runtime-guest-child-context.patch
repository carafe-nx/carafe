+static int runtime_register_guest_launch( const struct runtime_guest_child_launch *entry )
+{
+    unsigned int i;
+    int stored = 0;
+
+    pthread_mutex_lock( &runtime_guest_launch_mutex );
+    for (i = 0; i < ARRAY_SIZE(runtime_guest_launches); i++)
+    {
+        if (!runtime_guest_launches[i].teb)
+        {
+            runtime_guest_launches[i] = *entry;
+            stored = 1;
+            break;
+        }
+    }
+    pthread_mutex_unlock( &runtime_guest_launch_mutex );
+    return stored;
+}
+
+static int runtime_take_guest_launch( TEB *teb, struct runtime_guest_child_launch *out )
+{
+    unsigned int i;
+    int found = 0;
+
+    pthread_mutex_lock( &runtime_guest_launch_mutex );
+    for (i = 0; i < ARRAY_SIZE(runtime_guest_launches); i++)
+    {
+        if (runtime_guest_launches[i].teb == teb)
+        {
+            *out = runtime_guest_launches[i];
+            memset( &runtime_guest_launches[i], 0, sizeof(runtime_guest_launches[i]) );
+            found = 1;
+            break;
+        }
+    }
+    pthread_mutex_unlock( &runtime_guest_launch_mutex );
+    return found;
+}
+
+static void runtime_remove_guest_launch( TEB *teb )
+{
+    struct runtime_guest_child_launch unused;
+    runtime_take_guest_launch( teb, &unused );
+}
