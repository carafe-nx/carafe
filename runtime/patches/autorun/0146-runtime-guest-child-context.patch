+static void runtime_dup_unicode_string_64( const UNICODE_STRING *src, WCHAR **dst, UNICODE_STRING *out )
+{
+    SIZE_T max_bytes = src->MaximumLength ? src->MaximumLength : (src->Length ? src->Length + sizeof(WCHAR) : 0);
+
+    out->Length = src->Length;
+    out->MaximumLength = max_bytes;
+    if (src->Buffer && max_bytes)
+    {
+        out->Buffer = *dst;
+        if (src->Length) memcpy( *dst, src->Buffer, src->Length );
+        if (max_bytes > src->Length) memset( (char *)(*dst) + src->Length, 0, max_bytes - src->Length );
+        *dst = (WCHAR *)((char *)(*dst) + ((max_bytes + 1) & ~(SIZE_T)1));
+    }
+    else
+    {
+        out->Buffer = NULL;
+    }
+}
+
+static void runtime_dup_unicode_string_32( const UNICODE_STRING *src, WCHAR **dst, UNICODE_STRING32 *out )
+{
+    SIZE_T max_bytes = src->MaximumLength ? src->MaximumLength : (src->Length ? src->Length + sizeof(WCHAR) : 0);
+
+    out->Length = src->Length;
+    out->MaximumLength = max_bytes;
+    if (src->Buffer && max_bytes)
+    {
+        out->Buffer = PtrToUlong( *dst );
+        if (src->Length) memcpy( *dst, src->Buffer, src->Length );
+        if (max_bytes > src->Length) memset( (char *)(*dst) + src->Length, 0, max_bytes - src->Length );
+        *dst = (WCHAR *)((char *)(*dst) + ((max_bytes + 1) & ~(SIZE_T)1));
+    }
+    else
+    {
+        out->Buffer = 0;
+    }
+}
+
+static SIZE_T runtime_unicode_copy_bytes( const UNICODE_STRING *s )
+{
+    SIZE_T max_bytes = s->MaximumLength ? s->MaximumLength : (s->Length ? s->Length + sizeof(WCHAR) : 0);
+    return (s->Buffer && max_bytes) ? ((max_bytes + 1) & ~(SIZE_T)1) : 0;
+}
