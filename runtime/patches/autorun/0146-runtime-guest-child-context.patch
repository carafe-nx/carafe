+static RTL_USER_PROCESS_PARAMETERS *runtime_clone_process_params( const RTL_USER_PROCESS_PARAMETERS *src )
+{
+    RTL_USER_PROCESS_PARAMETERS *dst = NULL;
+    WCHAR *cursor;
+    SIZE_T size;
+    NTSTATUS status;
+
+    if (!src) return NULL;
+    size = sizeof(*dst)
+        + runtime_unicode_copy_bytes( &src->CurrentDirectory.DosPath )
+        + runtime_unicode_copy_bytes( &src->DllPath )
+        + runtime_unicode_copy_bytes( &src->ImagePathName )
+        + runtime_unicode_copy_bytes( &src->CommandLine )
+        + runtime_unicode_copy_bytes( &src->WindowTitle )
+        + runtime_unicode_copy_bytes( &src->Desktop )
+        + runtime_unicode_copy_bytes( &src->ShellInfo )
+        + runtime_unicode_copy_bytes( &src->RuntimeInfo )
+        + (src->Environment ? src->EnvironmentSize : 0);
+
+    status = NtAllocateVirtualMemory( NtCurrentProcess(), (void **)&dst, 0, &size,
+                                      MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE );
+    if (status || !dst) return NULL;
+    memset( dst, 0, size );
+    dst->AllocationSize           = size;
+    dst->Size                     = size;
+    dst->Flags                    = src->Flags | PROCESS_PARAMS_FLAG_NORMALIZED;
+    dst->DebugFlags               = src->DebugFlags;
+    dst->ConsoleHandle            = src->ConsoleHandle;
+    dst->ConsoleFlags             = src->ConsoleFlags;
+    dst->hStdInput                = src->hStdInput;
+    dst->hStdOutput               = src->hStdOutput;
+    dst->hStdError                = src->hStdError;
+    dst->CurrentDirectory.Handle  = src->CurrentDirectory.Handle;
+    dst->dwX                      = src->dwX;
+    dst->dwY                      = src->dwY;
+    dst->dwXSize                  = src->dwXSize;
+    dst->dwYSize                  = src->dwYSize;
+    dst->dwXCountChars            = src->dwXCountChars;
+    dst->dwYCountChars            = src->dwYCountChars;
+    dst->dwFillAttribute          = src->dwFillAttribute;
+    dst->dwFlags                  = src->dwFlags;
+    dst->wShowWindow              = src->wShowWindow;
+    dst->ProcessGroupId           = src->ProcessGroupId;
+
+    cursor = (WCHAR *)(dst + 1);
+    runtime_dup_unicode_string_64( &src->CurrentDirectory.DosPath, &cursor, &dst->CurrentDirectory.DosPath );
+    runtime_dup_unicode_string_64( &src->DllPath, &cursor, &dst->DllPath );
+    runtime_dup_unicode_string_64( &src->ImagePathName, &cursor, &dst->ImagePathName );
+    runtime_dup_unicode_string_64( &src->CommandLine, &cursor, &dst->CommandLine );
+    runtime_dup_unicode_string_64( &src->WindowTitle, &cursor, &dst->WindowTitle );
+    runtime_dup_unicode_string_64( &src->Desktop, &cursor, &dst->Desktop );
+    runtime_dup_unicode_string_64( &src->ShellInfo, &cursor, &dst->ShellInfo );
+    runtime_dup_unicode_string_64( &src->RuntimeInfo, &cursor, &dst->RuntimeInfo );
+    if (src->Environment && src->EnvironmentSize)
+    {
+        dst->Environment = cursor;
+        dst->EnvironmentSize = src->EnvironmentSize;
+        memcpy( cursor, src->Environment, src->EnvironmentSize );
+    }
+    return dst;
+}
