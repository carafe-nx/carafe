+    struct thread_data *data;
+    TEB *saved_teb;
+    TEB *child_teb;
+    HMODULE native = NULL, shared_guest = NULL;
+    void *initialize = NULL;
+    SIZE_T guest_size = 0;
+
+    if (!ctx || !ctx->peb || !ctx->initial_teb || !image_name) return STATUS_INVALID_PARAMETER;
+
+    pthread_mutex_lock( &runtime_wow64_init_mutex );
+    if (runtime_wow64_initialize)
+    {
+        if (runtime_wow64_ldr_peb)
+            runtime_copy_wow64_loader_peb( ctx->peb, runtime_wow64_ldr_peb );
+        else if (NtCurrentTeb() && NtCurrentTeb()->Peb && NtCurrentTeb()->WowTebOffset)
+            runtime_copy_wow64_loader_peb( ctx->peb, NtCurrentTeb()->Peb );
+        pthread_mutex_unlock( &runtime_wow64_init_mutex );
+        return STATUS_SUCCESS;
+    }
+
+    data = get_thread_data();
+    saved_teb = data->teb;
+    child_teb = (TEB *)ctx->initial_teb;
+    memset( child_teb, 0, ctx->teb_block_size );
+    child_teb->Peb = ctx->peb;
+    child_teb->Tib.Self = &child_teb->Tib;
+    child_teb->WowTebOffset = (LONG)((sizeof(TEB) + 0xfff) & ~(SIZE_T)0xfff);
+    child_teb->ClientId = saved_teb ? saved_teb->ClientId : make_client_id( 0, 0 );
+
+    prev_ctx = wine_nx_virtual_set_guest_ctx( 0 );
+    data->teb = child_teb;
+    status = wine_nx_loader_bootstrap( image_name );
+    if (!status)
+        status = wine_nx_loader_prepare_wow64( &native, &initialize, runtime_fex );
+    data->teb = saved_teb;
+
+    if (!status)
+    {
+        status = map_pe_image_with_limit( WINE_NX_RUNTIME_SYSWOW64 "/ntdll.dll", 0x7fffffff,
+                                          (void **)&shared_guest, &guest_size, NULL );
+        if (!status) status = virtual_relocate_module( shared_guest );
+        if (!status && ((ULONG_PTR)shared_guest > 0xffffffff ||
+                        guest_size > 0x100000000ULL - (ULONG_PTR)shared_guest))
+            status = STATUS_INVALID_ADDRESS;
+        if (!status)
+            status = wine_nx_prepare_wow64_native_ntdll_local( native, shared_guest );
+    }
+    wine_nx_virtual_set_guest_ctx( prev_ctx );
+
+    if (!status)
+    {
+        static PEB wow64_loader_peb_template;
+        runtime_copy_wow64_loader_peb( &wow64_loader_peb_template, ctx->peb );
+        runtime_wow64_ldr_peb = &wow64_loader_peb_template;
+        runtime_wow64_native_ntdll = native;
+        runtime_wow64_initialize = initialize;
+        wine_nx_wow64_thread_start = runtime_start_x86_thread;
+        log_line( "[WOW64] on-demand child init ready native=%p guest=%p init=%p",
+                  native, shared_guest, initialize );
+    }
+    else
+    {
+        log_line( "[WOW64] on-demand child init failed status=%08x", (unsigned)status );
+    }
+    pthread_mutex_unlock( &runtime_wow64_init_mutex );
+    return status;
+}
+#endif
+
+static BOOL runtime_guest_child_thread_start( PRTL_THREAD_START_ROUTINE entry, void *arg,
+                                              BOOL suspend, TEB *teb )
+{
+    struct runtime_guest_child_launch launch;
+    unsigned int exit_code = STATUS_UNSUCCESSFUL;
+
+    if (!runtime_take_guest_launch( teb, &launch ))
+    {
+        memset( &launch, 0, sizeof(launch) );
+        launch.ctx_id = wine_nx_virtual_get_teb_guest_ctx( teb, &launch.child_pid, &launch.machine,
+                                                           &launch.child_ldr_init,
+                                                           &launch.child_rtl_user_thread_start,
+                                                           &launch.ntdll_module );
+        if (!launch.ctx_id) return FALSE;
+        launch.teb = teb;
+    }
+
+    wine_nx_virtual_set_guest_ctx( launch.ctx_id );
+    wine_nx_set_current_guest_child_pid( launch.child_pid );
+    wine_nx_thread_register( 'w', HandleToULong( teb->ClientId.UniqueThread ), teb );
+
+    if (horizon_guest_process_is_exiting( launch.child_pid, &exit_code ))
+    {
+        NtTerminateThread( GetCurrentThread(), (LONG)exit_code );
+        return TRUE;
+    }
+
+#ifdef WINE_NX_AMD64
+    if (launch.machine == IMAGE_FILE_MACHINE_AMD64)
+    {
+        wine_nx_start_arm64ec_child_thread( entry, arg, suspend, teb,
+                                            launch.child_ldr_init, launch.child_rtl_user_thread_start );
+    }
+#endif
+#ifdef WINE_NX_BOX64_INTERPRETER
+    if (launch.machine == IMAGE_FILE_MACHINE_I386 && runtime_wow64_initialize)
+    {
+        I386_CONTEXT *ctx = get_cpu_area( get_thread_data(), IMAGE_FILE_MACHINE_I386 );
+        WOW_TEB *wow_teb = get_wow_teb( teb );
+        XMM_SAVE_AREA32 fx = {0};
+
+        if (ctx && wow_teb && (ULONG_PTR)entry <= 0xffffffff && (ULONG_PTR)arg <= 0xffffffff)
+        {
+            memset( ctx, 0, sizeof(*ctx) );
+            ctx->ContextFlags = CONTEXT_I386_ALL;
+            ctx->Eax = PtrToUlong( entry );
+            ctx->Ebx = PtrToUlong( arg );
+            ctx->Esp = wow_teb->Tib.StackBase - 16;
+            ctx->Eip = PtrToUlong( launch.child_rtl_user_thread_start );
+            ctx->SegCs = 0x23;
+            ctx->SegDs = ctx->SegEs = ctx->SegGs = ctx->SegSs = 0x2b;
+            ctx->SegFs = 0x53;
+            ctx->EFlags = 0x202;
+            ctx->FloatSave.ControlWord = 0x27f;
+            ctx->FloatSave.TagWord = 0xffff;
+            fx.ControlWord = 0x27f;
+            fx.MxCsr = 0x1f80;
+            memcpy( ctx->ExtendedRegisters, &fx, sizeof(fx) );
+            teb->TlsSlots[WOW64_TLS_MAX_NUMBER - 2] = launch.ntdll_module;
+            teb->TlsSlots[WOW64_TLS_MAX_NUMBER - 1] = launch.child_ldr_init;
+            call_pe_entry_point( runtime_wow64_initialize );
+        }
+    }
+#endif
+
+    horizon_guest_process_begin_exit( launch.child_pid,
+                                      HandleToULong( teb->ClientId.UniqueThread ),
+                                      STATUS_UNSUCCESSFUL );
+    NtTerminateThread( GetCurrentThread(), STATUS_UNSUCCESSFUL );
+    return TRUE;
+}
+
+NTSTATUS wine_nx_runtime_prepare_guest_child_context( const char *unix_path,
+                                                      USHORT machine,
+                                                      RTL_USER_PROCESS_PARAMETERS *params,
+                                                      struct wine_nx_guest_va_peb *out_ctx,
+                                                      SECTION_IMAGE_INFORMATION *out_info )
+{
+    unsigned int ctx_id;
+    unsigned int prev_ctx;
+    void *module = NULL;
+    void *entry = NULL;
+    void *child_ntdll = NULL;
+    SIZE_T view_size = 0, ntdll_size = 0;
+    ULONG_PTR zero_bits;
+    BOOL relocated = FALSE;
+    SECTION_IMAGE_INFORMATION child_info;
+    RTL_USER_PROCESS_PARAMETERS *cloned_params;
+    NTSTATUS status;
+
+    if (!unix_path || !unix_path[0] || !out_ctx || !params) return STATUS_INVALID_PARAMETER;
+    if (machine != IMAGE_FILE_MACHINE_I386 && machine != IMAGE_FILE_MACHINE_AMD64)
+        return STATUS_INVALID_IMAGE_FORMAT;
+#ifndef WINE_NX_BOX64_INTERPRETER
+    if (machine == IMAGE_FILE_MACHINE_I386)
+        return STATUS_NOT_SUPPORTED;
+#endif
+
+    ctx_id = __atomic_add_fetch( &runtime_guest_ctx_seq, 1, __ATOMIC_RELAXED );
+    if (!ctx_id) ctx_id = __atomic_add_fetch( &runtime_guest_ctx_seq, 1, __ATOMIC_RELAXED );
+
+    zero_bits = (machine == IMAGE_FILE_MACHINE_I386) ? 0x7fffffff : 0;
+    prev_ctx = wine_nx_virtual_set_guest_ctx( ctx_id );
+    status = map_pe_image_with_limit( unix_path, zero_bits, &module, &view_size, &relocated );
+    wine_nx_virtual_set_guest_ctx( prev_ctx );
+    if (status)
+    {
+        wine_nx_virtual_release_guest_context( ctx_id );
+        return status;
+    }
+
+    if (!runtime_describe_image_info( module, view_size, &entry, &child_info ) ||
+        child_info.Machine != machine)
+    {
+        wine_nx_virtual_release_guest_context( ctx_id );
+        return STATUS_INVALID_IMAGE_FORMAT;
+    }
+
+    if (relocated && !runtime_image_has_base_relocs( module ))
+    {
+        log_line( "[CHILD] rejecting fixed-base mapping conflict path=%s mapped=%p", unix_path, module );
+        wine_nx_virtual_release_guest_context( ctx_id );
+        return STATUS_CONFLICTING_ADDRESSES;
+    }
+
+    if (machine == IMAGE_FILE_MACHINE_I386 &&
+        ((ULONG_PTR)module > 0xffffffff || view_size > 0x100000000ULL - (ULONG_PTR)module))
+    {
+        wine_nx_virtual_release_guest_context( ctx_id );
+        return STATUS_INVALID_ADDRESS;
+    }
+
+    memset( out_ctx, 0, sizeof(*out_ctx) );
+    out_ctx->ctx_id                = ctx_id;
+    out_ctx->machine               = machine;
+    out_ctx->image_characteristics = child_info.ImageCharacteristics;
+    out_ctx->main_module           = module;
+    out_ctx->main_module_size      = view_size;
+    out_ctx->entry_point           = entry;
+
+    status = wine_nx_virtual_alloc_guest_peb_block( out_ctx );
+    if (status)
+    {
+        wine_nx_virtual_release_guest_context( ctx_id );
+        memset( out_ctx, 0, sizeof(*out_ctx) );
+        return status;
+    }
+
+    prev_ctx = wine_nx_virtual_set_guest_ctx( ctx_id );
+    cloned_params = runtime_clone_process_params( params );
+    if (!cloned_params)
+    {
+        wine_nx_virtual_set_guest_ctx( prev_ctx );
+        wine_nx_virtual_release_guest_context( ctx_id );
+        memset( out_ctx, 0, sizeof(*out_ctx) );
+        return STATUS_NO_MEMORY;
+    }
+
+    runtime_init_peb_for_image( out_ctx->peb, module, cloned_params, &child_info );
+    if (out_ctx->wow_peb)
+    {
+        RTL_USER_PROCESS_PARAMETERS32 *wow_params = runtime_build_wow64_child_params( cloned_params );
+        if (!wow_params)
+        {
+            wine_nx_virtual_set_guest_ctx( prev_ctx );
+            wine_nx_virtual_release_guest_context( ctx_id );
+            memset( out_ctx, 0, sizeof(*out_ctx) );
+            return STATUS_NO_MEMORY;
+        }
+        out_ctx->wow_peb->ImageBaseAddress           = PtrToUlong( module );
+        out_ctx->wow_peb->ProcessParameters          = PtrToUlong( wow_params );
+        out_ctx->wow_peb->NumberOfProcessors         = cpu_count;
+        out_ctx->wow_peb->OSMajorVersion             = 10;
+        out_ctx->wow_peb->OSMinorVersion             = 0;
+        out_ctx->wow_peb->OSBuildNumber              = 19045;
+        out_ctx->wow_peb->OSPlatformId               = VER_PLATFORM_WIN32_NT;
+        out_ctx->wow_peb->ImageSubSystem             = child_info.SubSystemType;
+        out_ctx->wow_peb->ImageSubSystemMajorVersion = child_info.MajorSubsystemVersion;
+        out_ctx->wow_peb->ImageSubSystemMinorVersion = child_info.MinorSubsystemVersion;
+    }
+
+    if (machine == IMAGE_FILE_MACHINE_AMD64)
+    {
+        status = map_pe_image_with_limit( WINE_SYSTEM_DIR "/ntdll.dll", 0, &child_ntdll, &ntdll_size, NULL );
+        if (!status) status = virtual_relocate_module( child_ntdll );
+        if (!status)
+            status = wine_nx_prepare_arm64ec_child_ntdll( (HMODULE)child_ntdll, out_ctx->peb->EcCodeBitMap,
+                                                          &out_ctx->child_ldr_init,
+                                                          &out_ctx->child_rtl_user_thread_start );
+    }
+    else
+    {
+#ifdef WINE_NX_BOX64_INTERPRETER
+        ULONG ldr32 = 0, start32 = 0;
+
+        wine_nx_virtual_set_guest_ctx( prev_ctx );
+        status = runtime_ensure_wow64_initialized( out_ctx, &cloned_params->ImagePathName );
+        prev_ctx = wine_nx_virtual_set_guest_ctx( ctx_id );
+        if (!status)
+            status = map_pe_image_with_limit( WINE_NX_RUNTIME_SYSWOW64 "/ntdll.dll", 0x7fffffff,
+                                              &child_ntdll, &ntdll_size, NULL );
+        if (!status) status = virtual_relocate_module( child_ntdll );
+        if (!status && ((ULONG_PTR)child_ntdll > 0xffffffff ||
+                        ntdll_size > 0x100000000ULL - (ULONG_PTR)child_ntdll))
+            status = STATUS_INVALID_ADDRESS;
+        if (!status)
+            status = wine_nx_prepare_wow64_child_ntdll( runtime_wow64_native_ntdll, (HMODULE)child_ntdll,
+                                                        &ldr32, &start32 );
+        if (!status)
+        {
+            out_ctx->child_ldr_init = ULongToPtr( ldr32 );
+            out_ctx->child_rtl_user_thread_start = ULongToPtr( start32 );
+        }
+#else
+        status = STATUS_NOT_SUPPORTED;
+#endif
+    }
+    wine_nx_virtual_set_guest_ctx( prev_ctx );
+
+    if (status)
+    {
+        wine_nx_virtual_release_guest_context( ctx_id );
+        memset( out_ctx, 0, sizeof(*out_ctx) );
+        return status;
+    }
+
+    out_ctx->ntdll_module = child_ntdll;
+    if (out_info) *out_info = child_info;
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS wine_nx_runtime_spawn_guest_child( const char *unix_path,
+                                            USHORT machine,
+                                            RTL_USER_PROCESS_PARAMETERS *params,
+                                            ACCESS_MASK process_access,
+                                            ACCESS_MASK thread_access,
+                                            OBJECT_ATTRIBUTES *thread_attr,
+                                            ULONG process_flags,
+                                            ULONG thread_flags,
+                                            const unsigned int *inherit_handles,
+                                            unsigned int inherit_handle_count,
+                                            HANDLE *process_handle_out,
+                                            HANDLE *thread_handle_out,
+                                            ULONG *process_id_out,
+                                            ULONG *thread_id_out )
+{
+    struct wine_nx_guest_va_peb child_ctx;
+    struct runtime_guest_child_launch launch;
+    SECTION_IMAGE_INFORMATION child_info;
+    unsigned int proc_handle_val = 0, child_pid = 0, parent_pid = 0;
+    unsigned int std_handles[5];
+    HANDLE proc_handle = 0, thread_handle = 0;
+    ULONG thread_id = 0;
+    NTSTATUS status;
+
+    if (!process_handle_out || !thread_handle_out || !process_id_out || !thread_id_out)
+        return STATUS_INVALID_PARAMETER;
+
+    status = wine_nx_runtime_prepare_guest_child_context( unix_path, machine, params, &child_ctx, &child_info );
+    if (status) return status;
+
+    parent_pid = HandleToULong( NtCurrentTeb()->ClientId.UniqueProcess );
+    status = horizon_guest_process_create(
+        parent_pid, child_ctx.ctx_id, machine, (unsigned long long)(ULONG_PTR)child_ctx.peb,
+        process_access, &proc_handle_val, &child_pid );
+    if (status)
+    {
+        wine_nx_virtual_release_guest_context( child_ctx.ctx_id );
+        return status;
+    }
+
+    proc_handle = wine_server_ptr_handle( proc_handle_val );
+    child_ctx.child_pid = child_pid;
+
+    std_handles[0] = wine_server_obj_handle( params->hStdInput );
+    std_handles[1] = wine_server_obj_handle( params->hStdOutput );
+    std_handles[2] = wine_server_obj_handle( params->hStdError );
+    std_handles[3] = wine_server_obj_handle( params->ConsoleHandle );
+    std_handles[4] = wine_server_obj_handle( params->CurrentDirectory.Handle );
+    status = horizon_guest_process_inherit_handles(
+        parent_pid, child_pid, process_flags, inherit_handles, inherit_handle_count,
+        std_handles, ARRAY_SIZE(std_handles) );
+    if (status)
+    {
+        horizon_guest_process_destroy_failed( child_pid, status );
+        NtClose( proc_handle );
+        wine_nx_virtual_release_guest_context( child_ctx.ctx_id );
+        return status;
+    }
+
+    status = wine_nx_virtual_register_guest_context( &child_ctx );
+    if (status)
+    {
+        horizon_guest_process_destroy_failed( child_pid, status );
+        NtClose( proc_handle );
+        wine_nx_virtual_release_guest_context( child_ctx.ctx_id );
+        return status;
+    }
+
+    memset( &launch, 0, sizeof(launch) );
+    launch.teb = (TEB *)child_ctx.initial_teb;
+    launch.ctx_id = child_ctx.ctx_id;
+    launch.child_pid = child_pid;
+    launch.machine = machine;
+    launch.ntdll_module = child_ctx.ntdll_module;
+    launch.child_ldr_init = child_ctx.child_ldr_init;
+    launch.child_rtl_user_thread_start = child_ctx.child_rtl_user_thread_start;
+
+    wine_nx_child_thread_start = runtime_guest_child_thread_start;
+    if (!runtime_register_guest_launch( &launch ))
+    {
+        horizon_guest_process_destroy_failed( child_pid, STATUS_NO_MEMORY );
+        NtClose( proc_handle );
+        wine_nx_virtual_release_guest_context( child_ctx.ctx_id );
+        return STATUS_NO_MEMORY;
+    }
+
+    status = wine_nx_thread_spawn_guest_child(
+        proc_handle, child_pid, &child_ctx, child_ctx.ctx_id,
+        child_ctx.entry_point,
+        (machine == IMAGE_FILE_MACHINE_I386) ? (void *)child_ctx.wow_peb : (void *)child_ctx.peb,
+        thread_access, thread_attr, thread_flags,
+        child_info.MaximumStackSize, child_info.CommittedStackSize,
+        (machine == IMAGE_FILE_MACHINE_I386) ? child_ctx.user_space_wow_limit : 0,
+        &thread_handle, &thread_id );
+    if (status)
+    {
+        runtime_remove_guest_launch( (TEB *)child_ctx.initial_teb );
+        horizon_guest_process_destroy_failed( child_pid, status );
+        NtClose( proc_handle );
+        wine_nx_virtual_release_guest_context( child_ctx.ctx_id );
+        return status;
+    }
+
+    horizon_guest_process_arm( child_pid );
+    *process_handle_out = proc_handle;
+    *thread_handle_out = thread_handle;
+    *process_id_out = child_pid;
+    *thread_id_out = thread_id;
+    log_line( "[CHILD] spawned pid=%u tid=%u machine=0x%x base=%p entry=%p peb=%p",
+              child_pid, (unsigned)thread_id, machine, child_ctx.main_module,
+              child_ctx.entry_point, child_ctx.peb );
+    return STATUS_SUCCESS;
+}
+
 /***********************************************************************
  * Leaving the process
  *
