+    if (!src) return NULL;
+    size = sizeof(*dst)
+        + runtime_unicode_copy_bytes( &src->CurrentDirectory.DosPath )
+        + runtime_unicode_copy_bytes( &src->DllPath )
+        + runtime_unicode_copy_bytes( &src->ImagePathName )
+        + runtime_unicode_copy_bytes( &src->CommandLine )
+        + runtime_unicode_copy_bytes( &src->WindowTitle )
+        + runtime_unicode_copy_bytes( &src->Desktop )
+        + runtime_unicode_copy_bytes( &src->ShellInfo )
+        + runtime_unicode_copy_bytes( &src->RuntimeInfo )
+        + (src->Environment ? src->EnvironmentSize : 0);
+
+    status = NtAllocateVirtualMemory( NtCurrentProcess(), (void **)&dst, 0x7fffffff, &size,
+                                      MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE );
+    if (status || !dst) return NULL;
+    memset( dst, 0, size );
+    dst->AllocationSize           = (ULONG)size;
