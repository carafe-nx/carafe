+static int suspend_requested( struct nx_prof_thread *thread )
+{
+    return __atomic_load_n( &thread->stop[0], __ATOMIC_SEQ_CST ) & WINE_NX_STOP_SUSPEND;
+}
+
+static void hold_self( struct nx_prof_thread *thread )
+{
+    int free = 0;
+
+    if (__atomic_compare_exchange_n( &thread->held, &free, 1, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST ))
+        svcSignalToAddress( (void *)&thread->held, SignalType_Signal, 0, -1 );
+}
+
+static int block_begin( void )
+{
+    struct nx_prof_thread *thread = self_thread;
+
+    if (!thread || !wine_nx_kernel_frame || thread->blocked) return 0;
+    thread->held_frame = wine_nx_kernel_frame;
+    __atomic_store_n( &thread->blocked, 1, __ATOMIC_SEQ_CST );
+    if (suspend_requested( thread )) hold_self( thread );
+    return 1;
+}
+
+static void block_end( int blocked )
+{
+    if (blocked) __atomic_store_n( &self_thread->blocked, 0, __ATOMIC_SEQ_CST );
+}
+
+Result __wrap_svcWaitForAddress( void *address, u32 arb_type, s64 value, s64 timeout )
+{
+    int blocked = block_begin();
+    Result rc = __real_svcWaitForAddress( address, arb_type, value, timeout );
+
+    block_end( blocked );
+    return rc;
+}
+
+Result __wrap_svcWaitProcessWideKeyAtomic( u32 *key, u32 *tag_location, u32 self_tag, u64 timeout )
+{
+    int blocked = block_begin();
+    Result rc = __real_svcWaitProcessWideKeyAtomic( key, tag_location, self_tag, timeout );
+
+    block_end( blocked );
+    return rc;
+}
+
+Result __wrap_svcWaitSynchronization( s32 *index, const Handle *handles, s32 count, u64 timeout )
+{
+    int blocked = timeout ? block_begin() : 0;
+    Result rc = __real_svcWaitSynchronization( index, handles, count, timeout );
+
+    block_end( blocked );
+    return rc;
+}
+
+void __wrap_svcSleepThread( s64 nano )
+{
+    int blocked = nano > 0 ? block_begin() : 0;
+
+    __real_svcSleepThread( nano );
+    block_end( blocked );
+}
+
+const void *wine_nx_kernel_boundary( int stop_here )
+{
+    struct nx_prof_thread *thread = self_thread;
+
+    if (!thread) return NULL;
+    if (stop_here && wine_nx_kernel_frame && suspend_requested( thread ))
+    {
+        thread->held_frame = wine_nx_kernel_frame;
+        hold_self( thread );
+    }
+    while (__atomic_load_n( &thread->held, __ATOMIC_SEQ_CST ))
+        horizon_futex_wait( (const int *)&thread->held, 1, -1 );
+    if (!__atomic_load_n( &thread->changed_contexts, __ATOMIC_ACQUIRE )) return NULL;
+    return __atomic_exchange_n( &thread->changed_contexts, NULL, __ATOMIC_SEQ_CST );
+}
+
+int wine_nx_suspend_requested( void )
+{
+    return self_thread && suspend_requested( self_thread );
+}
+
+static struct nx_prof_thread *registered_locked( const void *teb, unsigned int tid )
+{
+    unsigned int i;
+
+    for (i = 0; i < NX_PROF_MAX_THREADS; i++)
+        if (registry[i].handle && registry[i].teb == (uintptr_t)teb && registry[i].tid == tid) return &registry[i];
+    return NULL;
+}
+
+void wine_nx_thread_signal( const void *teb, unsigned int tid )
+{
+    struct nx_prof_thread *thread;
+
+    if (!teb) return;
+    pthread_mutex_lock( &registry_mutex );
+    if ((thread = registered_locked( teb, tid ))) svcSignalToAddress( (void *)&thread->held, SignalType_Signal, 0, -1 );
+    pthread_mutex_unlock( &registry_mutex );
+}
+
+int wine_nx_thread_hold( const void *teb, unsigned int tid, const void **frame, int *changed )
+{
+    struct nx_prof_thread *thread;
+    int free = 0, held = 0;
+
+    if (!teb) return 0;
+    pthread_mutex_lock( &registry_mutex );
+    if ((thread = registered_locked( teb, tid )) &&
+        (__atomic_load_n( &thread->held, __ATOMIC_SEQ_CST ) ||
+         (__atomic_load_n( &thread->blocked, __ATOMIC_SEQ_CST ) &&
+          (__atomic_compare_exchange_n( &thread->held, &free, 1, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST ) ||
+           free))))
+    {
+        *frame = thread->held_frame;
+        *changed = __atomic_load_n( &thread->changed_contexts, __ATOMIC_SEQ_CST ) != NULL;
+        held = 1;
+    }
+    pthread_mutex_unlock( &registry_mutex );
+    return held;
+}
+
+void wine_nx_thread_release( const void *teb, unsigned int tid, const void *changed )
+{
+    struct nx_prof_thread *thread;
+
+    if (!teb) return;
+    pthread_mutex_lock( &registry_mutex );
+    if ((thread = registered_locked( teb, tid )))
+    {
+        if (changed) __atomic_store_n( &thread->changed_contexts, changed, __ATOMIC_SEQ_CST );
+        __atomic_store_n( &thread->held, 0, __ATOMIC_SEQ_CST );
+        svcSignalToAddress( (void *)&thread->held, SignalType_Signal, 0, -1 );
+    }
+    pthread_mutex_unlock( &registry_mutex );
+}
+
+void wine_nx_thread_wait_held( const void *teb, unsigned int tid, s64 timeout )
+{
+    struct nx_prof_thread *thread;
+
+    if (!teb) return;
+    pthread_mutex_lock( &registry_mutex );
+    thread = registered_locked( teb, tid );
+    pthread_mutex_unlock( &registry_mutex );
+    if (thread) __real_svcWaitForAddress( (void *)&thread->held, ArbitrationType_WaitIfEqual, 0, timeout );
+}
