+
+    prev_ctx = wine_nx_virtual_set_guest_ctx( ctx_id );
+    status = wine_nx_virtual_init_guest_teb( data, guest_ctx, child_pid );
+    if (!status) status = init_thread_stack( data->teb, stack_limit, stack_reserve, stack_commit );
+    wine_nx_virtual_set_guest_ctx( prev_ctx );
+    if (!status) status = spawn_thread( data );
+
+    if (status)
+    {
+        NtClose( handle );
+        close( data->request_fd );
+        virtual_free_thread_data( data );
+        return status;
+    }
+
+    *thread_handle_out = handle;
+    *thread_id_out = data->tid;
+    return STATUS_SUCCESS;
