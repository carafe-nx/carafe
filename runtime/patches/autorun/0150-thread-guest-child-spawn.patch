  * Called by the runtime once the program's threads are gone, on its way back to
  * the launcher: the loader cannot reset a heap that still lends pages out.
  */
+void wine_nx_thread_join_and_free_guest_data( void *ptr )
+{
+    extern void wine_nx_virtual_free_guest_thread_data( struct thread_data *data );
+    struct thread_data *data = ptr;
+
+    if (!data) return;
+    if (data->pthread_id)
+        pthread_join( data->pthread_id, NULL );
+    wine_nx_virtual_free_guest_thread_data( data );
+}
