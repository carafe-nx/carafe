+#ifdef __SWITCH__
+    case 0x00092004:
+    {
+        extern int carafeOverlayCompareFiles( const char *, const char *, int * ) __attribute__((weak));
+        ULONG other;
+        HANDLE handles[2];
+        char *paths[2] = { NULL, NULL };
+        unsigned int i;
+        int same;
+        if (in_size != sizeof(other) || out_size < sizeof(ULONG) || !in_buffer || !out_buffer)
+        {
+            status = STATUS_INVALID_PARAMETER;
+            break;
+        }
+        memcpy( &other, in_buffer, sizeof(other) );
