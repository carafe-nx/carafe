+            if ((status = server_get_unix_name( handles[i], &paths[i] ))) break;
+        if (!status && !carafeOverlayCompareFiles) status = STATUS_NOT_SUPPORTED;
+        if (!status)
+        {
+            int error = carafeOverlayCompareFiles( paths[0], paths[1], &same );
+            if (error) status = errno_to_status( error );
+            else
+            {
+                ULONG result = same;
+                memcpy( out_buffer, &result, sizeof(result) );
+                size = sizeof(result);
+            }
+        }
+        free( paths[0] );
+        free( paths[1] );
+        break;
+    }
