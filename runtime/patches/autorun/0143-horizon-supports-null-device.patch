+
+static ssize_t horizon_null_read( struct _reent *r, void *state, char *buffer, size_t size )
+{
+    return 0;
+}
+
+static ssize_t horizon_null_write( struct _reent *r, void *state, const char *buffer, size_t size )
+{
+    return size;
+}
+
+static int horizon_null_fstat( struct _reent *r, void *state, struct stat *st )
