+
+static const devoptab_t horizon_null_devoptab =
+{
+    .name = "winenull",
+    .structSize = 1,
+    .open_r = horizon_null_open,
+    .close_r = horizon_null_close,
+    .read_r = horizon_null_read,
+    .write_r = horizon_null_write,
+    .fstat_r = horizon_null_fstat,
+};
+
+static int horizon_null_device;
+
+static void horizon_null_init( void )
+{
+    horizon_null_device = AddDevice( &horizon_null_devoptab );
+}
+
+static int horizon_null_name( const unsigned char *data, unsigned int size, const char *name )
+{
+    unsigned int i;
+    if (size != strlen( name ) * sizeof(unsigned short)) return 0;
+    for (i = 0; i < size / sizeof(unsigned short); i++)
+    {
+        unsigned short c;
+        memcpy( &c, data + i * sizeof(c), sizeof(c) );
+        if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+        if (c != name[i]) return 0;
+    }
+    return 1;
+}
+
+static int horizon_null_open_fd( unsigned int access )
+{
+    static pthread_once_t once = PTHREAD_ONCE_INIT;
+    const int read_access = access & FILE_READ_DATA;
+    const int write_access = access & (FILE_WRITE_DATA | FILE_APPEND_DATA);
+    pthread_once( &once, horizon_null_init );
+    if (horizon_null_device < 0)
+    {
+        errno = ENODEV;
+        return -1;
+    }
+    return open( "winenull:", write_access ? (read_access ? O_RDWR : O_WRONLY) : O_RDONLY );
+}
