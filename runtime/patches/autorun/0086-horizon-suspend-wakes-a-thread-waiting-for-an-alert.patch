Carafe: with CARAFE_SUSPEND_WAKES=1 suspending a thread that has the suspend doorbell also gives it a stop
request and alerts it by its id. Such a thread, x86 code under FEX, stopped only when FEX found the doorbell
rung; one waiting for an alert (NtWaitForAlertByThreadId, under WaitOnAddress, SRW locks and condition
variables) stayed in Wine's own code, and a GetThreadContext on it waited forever: Unity's garbage collector
suspends every thread and reads its registers. The alert ends the wait as a spurious wake, which its callers
expect, and the thread stops at the end of the system call with its registers, as other threads do.
LGPL-2.1-or-later, as the file it changes.

--- a/dlls/ntdll/unix/horizon.c
+++ b/dlls/ntdll/unix/horizon.c
@@ -12453,6 +12453,18 @@ static int horizon_server_can_pause( void )
     return wine_nx_in_runtime_code && wine_nx_thread_pause_granted && wine_nx_thread_pause_granted();
 }
 
+static int horizon_server_suspend_wakes( void )
+{
+    static int on = -1;
+
+    if (on < 0)
+    {
+        const char *value = getenv( "CARAFE_SUSPEND_WAKES" );
+        on = value && value[0] == '1';
+    }
+    return on;
+}
+
 static void horizon_server_context_from_kernel( struct context_data *to, const ThreadContext *from )
 {
     unsigned int i;
@@ -12678,6 +12690,10 @@ static int horizon_server_handle_suspend_thread( struct horizon_server_connectio
 #ifndef HORIZON_STANDALONE_SYNTAX
         if (!status && object->thread.started && !reply.count)
             horizon_server_set_suspend_doorbell_locked( object, 1 );
+        if (!status && object->thread.started && !reply.count && horizon_server_has_doorbell_locked( object ) &&
+            horizon_server_suspend_wakes() &&
+            horizon_server_stop_request_locked( object, HORIZON_STOP_SUSPEND, 0, 0, NULL ))
+            NtAlertThreadByThreadId( ULongToHandle( object->thread.tid ) );
         if (!status && !reply.count && !horizon_server_has_doorbell_locked( object ) &&
             !horizon_server_freeze_locked( object ))
             horizon_server_stop_request_locked( object, HORIZON_STOP_SUSPEND, 0, 0, NULL );
