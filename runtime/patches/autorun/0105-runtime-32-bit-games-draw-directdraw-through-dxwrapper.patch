Carafe: a 32-bit game finds dxwrapper's ddraw.dll in C:\dxwrapper before Wine's own. dxwrapper draws DirectDraw and
Direct3D 1-7 through Direct3D 9, which Carafe's DXVK runs on Vulkan; Wine's ddraw needs an OpenGL context the
Switch does not give games.
LGPL-2.1-or-later, as the file it changes.

--- a/horizon-wine/source/runtime.c
+++ b/horizon-wine/source/runtime.c
@@ -1828,6 +1828,11 @@
         else
             log_line( "[DXVK] %s bundled payload C:\\%s; application-local DLLs take priority",
                       main_image_info.Machine == IMAGE_FILE_MACHINE_AMD64 ? "AMD64" : "x86", dxvk_dir );
+        if (main_image_info.Machine == IMAGE_FILE_MACHINE_I386)
+        {
+            snprintf( graphics_path, sizeof(graphics_path), "%sC:\\dxwrapper;C:\\%s;", vkd3d_path, dxvk_dir );
+            log_line( "[DXVK] DirectDraw and Direct3D 1-7 through dxwrapper from C:\\dxwrapper" );
+        }
     }
     else if (runtime_d3d != LAUNCHER_D3D_WINE)
         log_line( "[DXVK] selected payload is not installed; using Wine Direct3D" );
