+unsigned int wine_nx_virtual_get_teb_guest_ctx( const TEB *teb, DWORD *child_pid_out,
+                                                USHORT *machine_out, void **ldr_init_out,
+                                                void **rtl_start_out, void **ntdll_out )
+{
+    sigset_t sigset;
+    unsigned int i, ctx_id = 0;
+
+    if (!teb || !teb->Peb || teb->Peb == peb) return 0;
+    server_enter_uninterrupted_section( &virtual_mutex, &sigset );
+    for (i = 0; i < ARRAY_SIZE(guest_va_contexts); i++)
+    {
+        if (guest_va_contexts[i].ctx_id && guest_va_contexts[i].peb == teb->Peb)
+        {
+            ctx_id = guest_va_contexts[i].ctx_id;
+            if (child_pid_out) *child_pid_out = guest_va_contexts[i].child_pid;
+            if (machine_out) *machine_out = guest_va_contexts[i].machine;
+            if (ldr_init_out) *ldr_init_out = guest_va_contexts[i].child_ldr_init;
+            if (rtl_start_out) *rtl_start_out = guest_va_contexts[i].child_rtl_user_thread_start;
+            if (ntdll_out) *ntdll_out = guest_va_contexts[i].ntdll_module;
+            break;
+        }
+    }
+    server_leave_uninterrupted_section( &virtual_mutex, &sigset );
+    return ctx_id;
+}
