+NTSTATUS wine_nx_virtual_alloc_guest_peb_block( struct wine_nx_guest_va_peb *ctx )
+{
+    sigset_t sigset;
+    struct file_view *view = NULL;
+    void *ptr;
+    PEB *child_peb;
+    WOW_PEB *child_wow_peb = NULL;
+    BOOL child_wow64;
+    size_t block_size;
+    ULONG_PTR child_wow_limit = 0, limit_low = 0, limit_high = 0;
+    unsigned int prev_ctx;
+    NTSTATUS status;
+
+    if (!ctx || !ctx->ctx_id) return STATUS_INVALID_PARAMETER;
+    if (ctx->machine != IMAGE_FILE_MACHINE_I386 &&
+        ctx->machine != IMAGE_FILE_MACHINE_AMD64 &&
+        ctx->machine != IMAGE_FILE_MACHINE_ARM64)
+        return STATUS_INVALID_IMAGE_FORMAT;
+
+    child_wow64 = is_win64 && !is_machine_64bit( ctx->machine );
+    block_size = ROUND_SIZE( 0, sizeof(TEB), page_mask );
+    if (child_wow64) block_size += ROUND_SIZE( 0, sizeof(WOW_TEB), page_mask );
+    block_size += page_size;
+
+    if (child_wow64)
+    {
+        child_wow_limit = (ctx->image_characteristics & IMAGE_FILE_LARGE_ADDRESS_AWARE)
+            ? (limit_4g - 1) : (limit_2g - 1);
+        limit_high = child_wow_limit & ~granularity_mask;
+    }
+    else if (use_aslr())
+    {
+        limit_low = limit_4g;
+    }
+
+    server_enter_uninterrupted_section( &virtual_mutex, &sigset );
+    if (ctx->machine == IMAGE_FILE_MACHINE_AMD64 && !arm64ec_view)
+    {
+        prev_ctx = current_view_guest_ctx_id;
+        current_view_guest_ctx_id = 0;
+        alloc_arm64ec_map();
+        current_view_guest_ctx_id = prev_ctx;
+    }
+
+    prev_ctx = current_view_guest_ctx_id;
+    current_view_guest_ctx_id = ctx->ctx_id;
+    status = map_view( &view, NULL, 16 * block_size, 0,
+                       VPROT_READ | VPROT_WRITE, limit_low, limit_high, 0 );
+    current_view_guest_ctx_id = prev_ctx;
+    if (!status)
+    {
+        ptr = (char *)view->base + 14 * block_size;
+        child_peb = (PEB *)((char *)ptr + block_size);
+        if (child_wow64) child_wow_peb = (WOW_PEB *)((char *)child_peb + page_size);
+        status = set_protection( view, ptr, 2 * block_size, PAGE_READWRITE );
+        if (status)
+        {
+            delete_view( view );
+        }
+        else
+        {
+#ifdef WINE_NX_SWAP_POC
+            horizon_swap_exclude( view->base, 16 * block_size );
+#endif
+            memset( ptr, 0, 2 * block_size );
+            if (arm64ec_view && ctx->machine == IMAGE_FILE_MACHINE_AMD64)
+                child_peb->EcCodeBitMap = arm64ec_view->base;
+            if (peb)
+            {
+                child_peb->ApiSetMap = peb->ApiSetMap;
+                child_peb->SessionId = peb->SessionId;
+                child_peb->CriticalSectionTimeout = peb->CriticalSectionTimeout;
+                child_peb->HeapSegmentReserve = peb->HeapSegmentReserve;
+                child_peb->HeapSegmentCommit = peb->HeapSegmentCommit;
+                child_peb->HeapDeCommitTotalFreeThreshold = peb->HeapDeCommitTotalFreeThreshold;
+                child_peb->HeapDeCommitFreeBlockThreshold = peb->HeapDeCommitFreeBlockThreshold;
+            }
+            child_peb->ImageBaseAddress = ctx->main_module;
+            if (child_wow_peb)
+            {
+                void *wow_apiset = child_peb->ApiSetMap;
+                if (wow_apiset && (ULONG_PTR)wow_apiset > 0xffffffff)
+                {
+                    const API_SET_NAMESPACE *ns = (const API_SET_NAMESPACE *)wow_apiset;
+                    if (ns->Version == 6 && ns->Size && ns->Size <= 16 * 1024 * 1024)
+                    {
+                        struct file_view *apiset_view = NULL;
+                        size_t apiset_size = ROUND_SIZE( 0, ns->Size, page_mask );
+                        prev_ctx = current_view_guest_ctx_id;
+                        current_view_guest_ctx_id = ctx->ctx_id;
+                        if (!map_view( &apiset_view, NULL, apiset_size, 0,
+                                       VPROT_READ | VPROT_WRITE | VPROT_COMMITTED,
+                                       0, limit_high, 0 ))
+                        {
+                            memcpy( apiset_view->base, ns, ns->Size );
+                            wow_apiset = apiset_view->base;
+                        }
+                        current_view_guest_ctx_id = prev_ctx;
+                    }
+                }
+                child_wow_peb->ImageBaseAddress = PtrToUlong( ctx->main_module );
+                child_wow_peb->ApiSetMap = PtrToUlong( wow_apiset );
+                child_wow_peb->SessionId = child_peb->SessionId;
+                child_wow_peb->CriticalSectionTimeout.QuadPart = child_peb->CriticalSectionTimeout.QuadPart;
+                child_wow_peb->HeapSegmentReserve = child_peb->HeapSegmentReserve;
+                child_wow_peb->HeapSegmentCommit = child_peb->HeapSegmentCommit;
+                child_wow_peb->HeapDeCommitTotalFreeThreshold = child_peb->HeapDeCommitTotalFreeThreshold;
+                child_wow_peb->HeapDeCommitFreeBlockThreshold = child_peb->HeapDeCommitFreeBlockThreshold;
+            }
+            ctx->teb_block            = view->base;
+            ctx->teb_block_size       = block_size;
+            ctx->initial_teb          = ptr;
+            ctx->peb                  = child_peb;
+            ctx->wow_peb              = child_wow_peb;
+            ctx->user_space_wow_limit = child_wow_limit;
+            ctx->user_space_limit     = min( address_space_limit, host_addr_space_limit );
+            ctx->working_set_limit    = ctx->user_space_limit;
+        }
+    }
+    server_leave_uninterrupted_section( &virtual_mutex, &sigset );
+    return status;
+}
