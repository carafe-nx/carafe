+USHORT wine_nx_virtual_get_teb_machine( const TEB *teb )
+{
+    sigset_t sigset;
+    unsigned int i;
+    USHORT machine = main_image_info.Machine;
+
+    if (!teb || !teb->Peb || teb->Peb == peb) return machine;
+    server_enter_uninterrupted_section( &virtual_mutex, &sigset );
+    for (i = 0; i < ARRAY_SIZE(guest_va_contexts); i++)
+    {
+        if (guest_va_contexts[i].ctx_id && guest_va_contexts[i].peb == teb->Peb)
+        {
+            machine = guest_va_contexts[i].machine;
+            break;
+        }
+    }
+    server_leave_uninterrupted_section( &virtual_mutex, &sigset );
+    return machine;
+}
+
