+NTSTATUS wine_nx_virtual_init_guest_teb( struct thread_data *data, const struct wine_nx_guest_va_peb *ctx,
+                                         DWORD child_pid )
+{
+    sigset_t sigset;
+    TEB *teb;
+    NTSTATUS status;
+
+    if (!data || !ctx || !ctx->initial_teb || !ctx->peb) return STATUS_INVALID_PARAMETER;
+    teb = ctx->initial_teb;
+
+    server_enter_uninterrupted_section( &virtual_mutex, &sigset );
+    memset( teb, 0, ctx->teb_block_size );
+#ifdef _WIN64
+    if (ctx->wow_peb)
+    {
+        TEB32 *teb32 = (TEB32 *)((char *)teb + teb_offset);
+
+        teb32->Peb = PtrToUlong( ctx->wow_peb );
+        teb32->Tib.Self = PtrToUlong( teb32 );
+        teb32->Tib.ExceptionList = ~0u;
+        teb32->Tib.FiberData = 0x1e00;
+        teb32->ClientId.UniqueProcess = child_pid;
+        teb32->ClientId.UniqueThread  = data->tid;
+        teb32->ActivationContextStackPointer = PtrToUlong( &teb32->ActivationContextStack );
+        teb32->ActivationContextStack.FrameListCache.Flink =
+            teb32->ActivationContextStack.FrameListCache.Blink =
+                PtrToUlong( &teb32->ActivationContextStack.FrameListCache );
+        teb32->StaticUnicodeString.Buffer = PtrToUlong( teb32->StaticUnicodeBuffer );
+        teb32->StaticUnicodeString.MaximumLength = sizeof( teb32->StaticUnicodeBuffer );
+        teb32->RealClientId  = teb32->ClientId;
+        teb32->GdiBatchCount = PtrToUlong( teb );
+        teb32->WowTebOffset  = -teb_offset;
+        teb->Tib.ExceptionList = (void *)teb32;
+        teb->WowTebOffset = teb_offset;
+    }
+#endif
+    teb->Peb = ctx->peb;
+    teb->Tib.Self = &teb->Tib;
+    teb->Tib.StackBase = (void *)~0ul;
+    teb->Tib.FiberData = (void *)0x1e00;
+    teb->ClientId = make_client_id( child_pid, data->tid );
+    teb->ActivationContextStackPointer = &teb->ActivationContextStack;
+    InitializeListHead( &teb->ActivationContextStack.FrameListCache );
+    teb->StaticUnicodeString.Buffer = teb->StaticUnicodeBuffer;
+    teb->StaticUnicodeString.MaximumLength = sizeof(teb->StaticUnicodeBuffer);
+    teb->RealClientId = teb->ClientId;
+    data->teb = teb;
+    get_teb_data( data )->thread = data;
+    list_add_head( &teb_list, &data->entry );
+    status = signal_alloc_thread( data->teb );
+    if (status)
+    {
+        list_remove( &data->entry );
+        data->teb = NULL;
+    }
+    else
+    {
+        __atomic_add_fetch( &horizon_lifecycle.tebs, 1, __ATOMIC_RELAXED );
+    }
+    server_leave_uninterrupted_section( &virtual_mutex, &sigset );
+    return status;
+}
+
+NTSTATUS wine_nx_virtual_register_guest_context( const struct wine_nx_guest_va_peb *ctx )
+{
+    sigset_t sigset;
+    unsigned int i;
+    NTSTATUS status = STATUS_NO_MEMORY;
+
+    if (!ctx || !ctx->ctx_id || !ctx->peb) return STATUS_INVALID_PARAMETER;
+    server_enter_uninterrupted_section( &virtual_mutex, &sigset );
+    for (i = 0; i < ARRAY_SIZE(guest_va_contexts); i++)
+    {
+        if (guest_va_contexts[i].ctx_id == ctx->ctx_id)
+        {
+            guest_va_contexts[i] = *ctx;
+            status = STATUS_SUCCESS;
+            break;
+        }
+    }
+    if (status)
+    {
+        for (i = 0; i < ARRAY_SIZE(guest_va_contexts); i++)
+        {
+            if (!guest_va_contexts[i].ctx_id)
+            {
+                guest_va_contexts[i] = *ctx;
+                status = STATUS_SUCCESS;
+                break;
+            }
+        }
+    }
+    server_leave_uninterrupted_section( &virtual_mutex, &sigset );
+    return status;
+}
