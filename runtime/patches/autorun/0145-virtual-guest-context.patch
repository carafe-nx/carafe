+void wine_nx_virtual_free_guest_thread_data( struct thread_data *data )
+{
+    if (!data) return;
+    virtual_free_thread_data( data );
+    __atomic_sub_fetch( &horizon_lifecycle.worker_pthreads, 1, __ATOMIC_RELAXED );
+}
+
+unsigned int wine_nx_virtual_release_guest_context( unsigned int ctx_id )
+{
+    sigset_t sigset;
+    unsigned int i, released = 0;
+
+    if (!ctx_id) return 0;
+    server_enter_uninterrupted_section( &virtual_mutex, &sigset );
+    for (i = 0; i < ARRAY_SIZE(guest_va_contexts); i++)
+    {
+        if (guest_va_contexts[i].ctx_id == ctx_id)
+        {
+            memset( &guest_va_contexts[i], 0, sizeof(guest_va_contexts[i]) );
+            break;
+        }
+    }
+    for (;;)
+    {
+        struct file_view *victim = NULL;
+        struct file_view *view;
+        WINE_RB_FOR_EACH_ENTRY( view, &views_tree, struct file_view, entry )
+        {
+            if (view->guest_ctx_id == ctx_id)
+            {
+                victim = view;
+                break;
+            }
+        }
+        if (!victim) break;
+        delete_view( victim );
+        released++;
+    }
+    server_leave_uninterrupted_section( &virtual_mutex, &sigset );
+    return released;
+}
