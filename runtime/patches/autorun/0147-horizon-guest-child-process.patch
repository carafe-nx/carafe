+static void horizon_guest_process_stop_threads_locked( unsigned int child_pid, unsigned int exclude_tid,
+                                                       unsigned int exit_code );
+
+static struct horizon_server_object *horizon_guest_process_find_locked( unsigned int child_pid )
+{
+    struct horizon_server_object *object;
+
+    if (!child_pid) return NULL;
+    for (object = horizon_server_processes; object; object = object->process.next)
+        if (object->process.pid == child_pid) return object;
+    return NULL;
+}
+
+unsigned int horizon_guest_process_create( unsigned int parent_pid, unsigned int guest_ctx_id,
+                                           unsigned short machine, unsigned long long peb_addr,
+                                           unsigned int access, unsigned int *handle_out,
+                                           unsigned int *pid_out )
+{
+    struct horizon_server_handle_entry *entry;
+    struct horizon_server_object *object;
+    unsigned int child_pid;
+
+    if (!handle_out || !pid_out) return HORIZON_STATUS_INVALID_PARAMETER;
+    *handle_out = 0;
+    *pid_out = 0;
+
+    pthread_mutex_lock( &horizon_server_objects_mutex );
+    if (!parent_pid) parent_pid = horizon_server_root_pid;
+    entry = horizon_server_create_handle_for_pid_locked( parent_pid, HORIZON_SERVER_OBJECT_PROCESS );
+    if (!entry)
+    {
+        pthread_mutex_unlock( &horizon_server_objects_mutex );
+        return HORIZON_STATUS_NO_MEMORY;
+    }
+    child_pid = (unsigned int)__sync_add_and_fetch( &horizon_server_next_pid, 4 );
+    if (child_pid == parent_pid || child_pid == horizon_server_root_pid || !child_pid)
+        child_pid = (unsigned int)__sync_add_and_fetch( &horizon_server_next_pid, 4 );
+
+    object = entry->object;
+    entry->access = horizon_process_map_access( access );
+    object->refs++;
+    object->process.pid = child_pid;
+    object->process.ppid = parent_pid;
+    object->process.exit_code = 0x00000103u;
+    object->process.guest_ctx_id = guest_ctx_id;
+    object->process.live_threads = 0;
+    object->process.machine = machine;
+    object->process.is_child = 1;
+    object->process.armed = 0;
+    object->process.exiting = 0;
+    object->process.terminated = 0;
+    object->process.peb = peb_addr;
+    object->process.exited_threads = NULL;
+    object->process.next = horizon_server_processes;
+    horizon_server_processes = object;
+
+    *handle_out = entry->handle;
+    *pid_out = child_pid;
+    pthread_mutex_unlock( &horizon_server_objects_mutex );
+    return HORIZON_STATUS_SUCCESS;
+}
+
+static unsigned int horizon_guest_process_inherit_one_locked( unsigned int parent_pid, unsigned int child_pid,
+                                                              unsigned int handle, int require_exists )
+{
+    struct horizon_server_handle_entry *src, *dst;
+
+    if (!handle || handle == HORIZON_CURRENT_PROCESS_HANDLE || handle == HORIZON_CURRENT_THREAD_HANDLE)
+        return HORIZON_STATUS_SUCCESS;
+    if (horizon_server_find_handle_for_pid_locked( child_pid, handle ))
+        return HORIZON_STATUS_SUCCESS;
+    src = horizon_server_find_handle_for_pid_locked( parent_pid, handle );
+    if (!src) return require_exists ? HORIZON_STATUS_INVALID_HANDLE : HORIZON_STATUS_SUCCESS;
+    dst = calloc( 1, sizeof(*dst) );
+    if (!dst) return HORIZON_STATUS_NO_MEMORY;
+    dst->handle = src->handle;
+    dst->owner_pid = child_pid;
+    dst->access = src->access;
+    dst->inherit = src->inherit;
+    dst->object = src->object;
+    dst->object->refs++;
+    if (dst->object->type == HORIZON_SERVER_OBJECT_COMPLETION) dst->object->completion_closed = 0;
+    horizon_server_link_handle_locked( dst );
+    return HORIZON_STATUS_SUCCESS;
+}
+
+unsigned int horizon_guest_process_inherit_handles( unsigned int parent_pid, unsigned int child_pid,
+                                                    unsigned int process_flags,
+                                                    const unsigned int *handles, unsigned int handle_count,
+                                                    const unsigned int *std_handles, unsigned int std_count )
+{
+    unsigned int status = HORIZON_STATUS_SUCCESS;
+    unsigned int i;
+
+    if (!child_pid || child_pid == horizon_server_root_pid) return HORIZON_STATUS_INVALID_PARAMETER;
+    if (!(process_flags & 0x00000004u)) return HORIZON_STATUS_SUCCESS;
+
+    pthread_mutex_lock( &horizon_server_objects_mutex );
+    if (!parent_pid) parent_pid = horizon_server_root_pid;
+    if (handles && handle_count)
+    {
+        for (i = 0; i < handle_count; i++)
+        {
+            status = horizon_guest_process_inherit_one_locked( parent_pid, child_pid, handles[i], 1 );
+            if (status) break;
+        }
+    }
+    else
+    {
+        struct horizon_server_handle_entry *entry;
+        unsigned int count = 0, cap = 0;
+        unsigned int *list = NULL;
+
+        for (entry = horizon_server_handles; entry; entry = entry->next)
+        {
+            if (entry->owner_pid == parent_pid && entry->inherit)
+            {
+                if (count == cap)
+                {
+                    unsigned int next_cap = cap ? cap * 2 : 16;
+                    unsigned int *next_list = realloc( list, next_cap * sizeof(*next_list) );
+                    if (!next_list)
+                    {
+                        status = HORIZON_STATUS_NO_MEMORY;
+                        break;
+                    }
+                    list = next_list;
+                    cap = next_cap;
+                }
+                list[count++] = entry->handle;
+            }
+        }
+        for (i = 0; !status && i < count; i++)
+            status = horizon_guest_process_inherit_one_locked( parent_pid, child_pid, list[i], 0 );
+        free( list );
+        for (i = 0; !status && std_handles && i < std_count; i++)
+            status = horizon_guest_process_inherit_one_locked( parent_pid, child_pid, std_handles[i], 0 );
+    }
+
+    if (status)
+        horizon_server_close_all_handles_for_pid_locked( child_pid );
+    pthread_mutex_unlock( &horizon_server_objects_mutex );
+    return status;
+}
+
+void horizon_guest_process_arm( unsigned int child_pid )
+{
+    struct horizon_server_object *proc;
+
+    if (!child_pid) return;
+    pthread_mutex_lock( &horizon_server_objects_mutex );
+    proc = horizon_guest_process_find_locked( child_pid );
+    if (proc && proc->process.is_child)
+    {
+        proc->process.armed = 1;
+        if (!proc->process.live_threads && !proc->process.terminated)
+            horizon_guest_process_finalize_locked( proc );
+    }
+    pthread_mutex_unlock( &horizon_server_objects_mutex );
+}
+
+void horizon_guest_process_destroy_failed( unsigned int child_pid, unsigned int exit_code )
+{
+    struct horizon_server_object *proc;
+
+    if (!child_pid) return;
+    pthread_mutex_lock( &horizon_server_objects_mutex );
+    horizon_server_close_all_handles_for_pid_locked( child_pid );
+    proc = horizon_guest_process_find_locked( child_pid );
+    if (proc && proc->process.is_child)
+    {
+        proc->process.armed = 0;
+        proc->process.exiting = 1;
+        proc->process.guest_ctx_id = 0;
+        if (!proc->process.terminated)
+        {
+            proc->process.exit_code = exit_code;
+            proc->process.terminated = 1;
+            horizon_sync_notify_object_locked( proc, 0 );
+            horizon_server_signal_changed_locked();
+            if (!--proc->refs) horizon_server_free_object( proc );
+        }
+    }
+    pthread_mutex_unlock( &horizon_server_objects_mutex );
+}
+
+int horizon_guest_process_queue_exited_thread( unsigned int child_pid, void *thread_data )
+{
+    struct horizon_server_object *proc;
+    struct horizon_guest_exited_thread *node;
+
+    if (!child_pid || !thread_data) return 0;
+    node = malloc( sizeof(*node) );
+    if (!node) return 0;
+    node->thread_data = thread_data;
+
+    pthread_mutex_lock( &horizon_server_objects_mutex );
+    proc = horizon_guest_process_find_locked( child_pid );
+    if (!proc || !proc->process.is_child)
+    {
+        pthread_mutex_unlock( &horizon_server_objects_mutex );
+        free( node );
+        return 0;
+    }
+    node->next = proc->process.exited_threads;
+    proc->process.exited_threads = node;
+    pthread_mutex_unlock( &horizon_server_objects_mutex );
+    return 1;
+}
+
+int horizon_guest_process_is_exiting( unsigned int child_pid, unsigned int *exit_code_out )
+{
+    struct horizon_server_object *proc;
+    int exiting = 0;
+
+    if (!child_pid) return 0;
+    pthread_mutex_lock( &horizon_server_objects_mutex );
+    proc = horizon_guest_process_find_locked( child_pid );
+    if (proc && proc->process.is_child && (proc->process.exiting || proc->process.terminated))
+    {
+        exiting = 1;
+        if (exit_code_out) *exit_code_out = proc->process.exit_code;
+    }
+    pthread_mutex_unlock( &horizon_server_objects_mutex );
+    return exiting;
+}
+
+int horizon_guest_process_terminate_others( unsigned int child_pid, unsigned int exclude_tid,
+                                            unsigned int exit_code )
+{
+    struct horizon_server_object *proc;
+    int found = 0;
+
+    if (!child_pid) return 0;
+    pthread_mutex_lock( &horizon_server_objects_mutex );
+    proc = horizon_guest_process_find_locked( child_pid );
+    if (proc && proc->process.is_child)
+    {
+        if (!proc->process.exiting)
+        {
+            proc->process.exiting = 1;
+            proc->process.exit_code = exit_code;
+        }
+        horizon_guest_process_stop_threads_locked( child_pid, exclude_tid, proc->process.exit_code );
+        found = 1;
+    }
+    pthread_mutex_unlock( &horizon_server_objects_mutex );
+    return found;
+}
+
+int horizon_guest_process_begin_exit( unsigned int child_pid, unsigned int exclude_tid,
+                                      unsigned int exit_code )
+{
+    struct horizon_server_object *proc;
+    int found = 0;
+
+    if (!child_pid) return 0;
+    pthread_mutex_lock( &horizon_server_objects_mutex );
+    proc = horizon_guest_process_find_locked( child_pid );
+    if (proc && proc->process.is_child)
+    {
+        proc->process.exiting = 1;
+        proc->process.exit_code = exit_code;
+        horizon_guest_process_stop_threads_locked( child_pid, exclude_tid, exit_code );
+        found = 1;
+    }
+    pthread_mutex_unlock( &horizon_server_objects_mutex );
+    return found;
+}
+
+unsigned int horizon_guest_process_query( unsigned int caller_pid, unsigned int handle, unsigned int *pid_out,
+                                          unsigned int *ppid_out, unsigned int *exit_code_out,
+                                          unsigned long long *peb_out, unsigned short *machine_out )
+{
+    struct horizon_server_handle_entry *entry;
+    struct horizon_server_object *object = NULL;
+    unsigned int status = HORIZON_STATUS_SUCCESS;
+
+    pthread_mutex_lock( &horizon_server_objects_mutex );
+    if (!caller_pid) caller_pid = horizon_server_root_pid;
+    entry = horizon_server_find_handle_for_pid_locked( caller_pid, handle );
+    if (!entry) status = HORIZON_STATUS_INVALID_HANDLE;
+    else if (!entry->object || entry->object->type != HORIZON_SERVER_OBJECT_PROCESS ||
+             !entry->object->process.is_child)
+        status = HORIZON_STATUS_OBJECT_TYPE_MISMATCH;
+    else object = entry->object;
+    if (!status)
+    {
+        if (pid_out) *pid_out = object->process.pid;
+        if (ppid_out) *ppid_out = object->process.ppid;
+        if (exit_code_out) *exit_code_out = object->process.exit_code;
+        if (peb_out) *peb_out = object->process.peb;
+        if (machine_out) *machine_out = object->process.machine;
+    }
+    pthread_mutex_unlock( &horizon_server_objects_mutex );
+    return status;
+}
+
+int horizon_guest_process_terminate_handle( unsigned int caller_pid, unsigned int handle, unsigned int exit_code )
+{
+    struct horizon_server_handle_entry *entry;
+    struct horizon_server_object *object = NULL;
+    int terminated = 0;
+
+    pthread_mutex_lock( &horizon_server_objects_mutex );
+    if (!caller_pid) caller_pid = horizon_server_root_pid;
+    entry = horizon_server_find_handle_for_pid_locked( caller_pid, handle );
+    if (entry && entry->object && entry->object->type == HORIZON_SERVER_OBJECT_PROCESS &&
+        entry->object->process.is_child)
+    {
+        object = entry->object;
+        if (!object->process.terminated)
+        {
+            object->process.exiting = 1;
+            object->process.exit_code = exit_code;
+            horizon_guest_process_stop_threads_locked( object->process.pid, 0, exit_code );
+            if (!object->process.live_threads)
+                horizon_guest_process_finalize_locked( object );
+        }
+        terminated = 1;
+    }
+    pthread_mutex_unlock( &horizon_server_objects_mutex );
+    return terminated;
+}
