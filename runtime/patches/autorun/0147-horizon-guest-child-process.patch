+static void horizon_guest_process_stop_threads_locked( unsigned int child_pid, unsigned int exclude_tid,
+                                                       unsigned int exit_code )
+{
+    struct horizon_server_object *thread;
+
+    for (thread = horizon_server_threads; thread; thread = thread->thread_next)
+    {
+        if (thread->thread.pid != child_pid || thread->thread.terminated) continue;
+        if (exclude_tid && thread->thread.tid == exclude_tid) continue;
+        horizon_thread_set_exit_code( &thread->thread, exit_code );
+        __atomic_store_n( &thread->ending, 1, __ATOMIC_RELEASE );
+        thread->thread.suspend = 0;
+#ifndef HORIZON_STANDALONE_SYNTAX
+        horizon_server_stop_request_locked( thread, HORIZON_STOP_END, HORIZON_STOP_SUSPEND, exit_code, NULL );
+        horizon_server_set_suspend_doorbell_locked( thread, 0 );
+        horizon_server_thaw_locked( thread );
+        horizon_server_release_locked( thread );
+        NtAlertThreadByThreadId( ULongToHandle( thread->thread.tid ) );
+#endif
+    }
+    horizon_server_signal_changed_locked();
+}
