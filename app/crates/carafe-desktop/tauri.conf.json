{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Carafe",
  "identifier": "app.carafe.builder",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../ui/dist",
    "beforeDevCommand": "npm run dev --workspace ui",
    "beforeBuildCommand": "npm run build --workspace ui"
  },
  "app": {
    "windows": [
      {
        "title": "Carafe",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost https://cdn2.steamgriddb.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../../../assets/logo/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"],
        "compression": "zlib"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFM0ZGQTUwOEI4N0Y5QTMKUldTaitZZUxVUG8vL3FyNmdrN0lNZ1BhU2NnYkVxRkNNL3NSbG1ZQWtKS3BKOUxpcGRXSVpLQVgK",
      "endpoints": ["https://github.com/carafe-nx/carafe/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
